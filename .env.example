# ── Server ───────────────────────────────────────────────────────────────
PORT=8787
# 127.0.0.1 = this machine only. Use 0.0.0.0 to reach it from your LAN (Docker sets this).
HOST=127.0.0.1
# Reaching it by a name other than localhost / an IP address (e.g. http://pi.local:8787)? List the name here,
# comma-separated. Any other name is refused, which blocks DNS-rebinding attacks from websites.
# ALLOWED_HOSTS=pi.local
DATA_DIR=./data
LOG_LEVEL=info
# Scheduled digests: windows (Task Scheduler, default on Windows) | internal (in-process cron, Docker/Pi) | off
# SCHEDULER=windows

# ── LLM tiers (order is chosen in the Config UI → AI Engine) ────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Per-attempt timeout, attempts per tier, delay between attempts
LLM_TIMEOUT_MS=240000
LLM_MAX_TRIES=5
LLM_RETRY_DELAY_MS=5000

# ── Feeds ────────────────────────────────────────────────────────────────
FEED_TIMEOUT_MS=20000
FEED_CONCURRENCY=8

# ── Delivery ─────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=

# Gmail: smtp.gmail.com / 465 / true, with an App Password (not your account password)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Used when the Config UI's email address is blank
EMAIL_TO=

# ── One-time import (first boot only) ────────────────────────────────────
# Path to your n8n-era digest-config.json. API keys / webhook in it are ignored.
LEGACY_CONFIG_PATH=
