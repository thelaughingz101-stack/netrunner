{
  "name": "netrunner",
  "version": "1.0.0",
  "description": "NetRunner news digest — standalone, self-hosted (migrated from n8n)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "desktop": "node --import tsx src/desktop.ts",
    "install:desktop": "node scripts/install-desktop.mjs",
    "dev": "tsx watch src/index.ts",
    "digest": "tsx src/cli.ts",
    "import:n8n": "tsx scripts/import-n8n-files.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/vendor.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@babel/standalone": "7.29.10",
    "@fastify/static": "^10.1.5",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "luxon": "^3.7.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.0.16",
    "p-limit": "^7.2.0",
    "pino": "^10.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rss-parser": "^3.13.0",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.9.1",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.3"
  }
}
